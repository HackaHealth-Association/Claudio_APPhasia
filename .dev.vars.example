# Copy to .dev.vars for local development (`npm run dev:api`).
# In production these are set once with `wrangler secret put NAME`.

# --- Sentence generation ---------------------------------------------------
# One of: groq_fast | openai | xai_grok | gemini | anthropic
LLM_PROVIDER=groq_fast

# Set the key matching the provider above. Only that one is needed.
GROQ_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override the provider's default model without touching code.
# LLM_MODEL=

# --- Speech ----------------------------------------------------------------
CARTESIA_API_KEY=

# Optional voice overrides. The default is Claudio's own cloned voice
# (Swiss-German, private to this account).
# Library alternatives: Vreni 40e0f496-a220-46bb-975a-7ef465b3d92b (de-CH, f),
# Eleni c0c52199-e35f-4681-b68a-949ee499617e (de-CH, f),
# Moritz 4ad22058-7cb6-402c-a115-196cbfc25dce (de-DE, m).
# CARTESIA_VOICE_ID=f4790968-50f6-451f-be13-f1fa2d47ac47
# CARTESIA_MODEL=sonic-3
# CARTESIA_SPEED=0.8

# --- Access ----------------------------------------------------------------
# Comma-separated origins allowed to call the API from a different domain.
# Leave empty for the normal case: the frontend is served from this same
# Worker, so no cross-origin request is made at all. localhost is always
# allowed so `npm run dev` works.
ALLOWED_ORIGINS=
