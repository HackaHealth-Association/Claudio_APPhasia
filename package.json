{
  "name": "claudio-apphasia",
  "private": true,
  "version": "1.0.0",
  "description": "Speech assistance tool for a physiotherapist with aphasia",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "wrangler dev",
    "build": "npm --prefix frontend run build",
    "deploy": "npm run build && wrangler deploy",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
